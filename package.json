{
  "name": "pi-session-inspector",
  "version": "0.4.0",
  "type": "module",
  "author": "boadij",
  "description": "Branch-aware, bounded Pi session inspection tool",
  "keywords": [
    "pi-package",
    "pi",
    "session"
  ],
  "scripts": {
    "test": "PI_SESSION_INSPECTOR_PI=1 pi -e ./extensions/session-inspector.test.ts --print --no-session --offline --no-extensions -p ''"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "extensions/"
  ],
  "pi": {
    "extensions": [
      "./extensions/session-inspector.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boadij/pi-session-inspector.git"
  }
}
